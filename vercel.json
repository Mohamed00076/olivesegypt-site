{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/admin/analytics",
      "destination": "/admin/analytics/index.html"
    },
    {
      "source": "/admin/analytics/",
      "destination": "/admin/analytics/index.html"
    },
    {
      "source": "/((?!api/|assets/|admin/|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ]
}
